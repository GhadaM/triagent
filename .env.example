# Copy to .env and fill in. Never commit .env.
TRIAGENT_ENV=dev
TRIAGENT_GITHUB_REPO=kubernetes/kubernetes
# Fine-grained personal access token with public-repo read access
TRIAGENT_GITHUB_TOKEN=
TRIAGENT_DATABASE_URL=postgresql://triagent:triagent@localhost:5432/triagent
# Needed from Week 3
TRIAGENT_GROQ_API_KEY=
